# ===========================================
# Superintell Arena Backend - Environment Config
# ===========================================
# Copy this file to .env and fill in your values.
# The LLM_PROVIDER setting controls which backend LiteLLM routes to.

# -------------------------------------------
# LLM Provider Configuration
# -------------------------------------------

# Provider name: openai | anthropic | deepseek | azure | mistral | cohere
# For any OpenAI-compatible endpoint, use "openai" with a custom LLM_BASE_URL.
LLM_PROVIDER=openai

# --- OpenAI (default) ---
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# --- Anthropic Claude ---
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL_NAME=claude-sonnet-4-20250514
# (No LLM_BASE_URL needed - litellm handles Anthropic natively)

# --- DeepSeek ---
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-...
# LLM_MODEL_NAME=deepseek-chat
# (No LLM_BASE_URL needed - litellm handles DeepSeek natively)

# --- OpenAI-compatible (vLLM, LocalAI, Ollama, etc.) ---
# LLM_PROVIDER=openai
# LLM_API_KEY=not-needed
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL_NAME=my-local-model

# -------------------------------------------
# Boost LLM (optional, for parallel simulation acceleration)
# -------------------------------------------
# LLM_BOOST_PROVIDER=openai
# LLM_BOOST_API_KEY=sk-...
# LLM_BOOST_BASE_URL=https://api.openai.com/v1
# LLM_BOOST_MODEL_NAME=gpt-4o-mini

# -------------------------------------------
# Zep Cloud (memory / knowledge graph)
# -------------------------------------------
ZEP_API_KEY=z_...

# -------------------------------------------
# Flask
# -------------------------------------------
SECRET_KEY=change-me-in-production
FLASK_DEBUG=True

# -------------------------------------------
# Thinker distillation (whole-book uploads -> persona cards)
# -------------------------------------------
# Cheap model for bulk reading; falls back to LLM_MODEL_NAME if unset
LLM_DISTILL_MODEL_NAME=claude-haiku-4-5
# Files above this many characters get distilled (default 50000)
# THINKER_DISTILL_THRESHOLD=50000
